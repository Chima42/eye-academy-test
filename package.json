{
  "name": "eye-academy-voice-viva",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "generate-routes": "vite build",
    "build": "vite build",
