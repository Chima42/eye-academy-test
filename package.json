    "@tanstack/react-start": "1.169.7",
    "firebase": "^13.4.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.7",
    "@types/node": "^22.10.2",
